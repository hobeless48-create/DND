{
  "name": "blackstone-dungeon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --watch server/index.mjs\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
