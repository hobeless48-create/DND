    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
